// Pickle Pool — Quest Pre-Registration Schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Registration {
  id              Int      @id @default(autoincrement())
  twitterHandle   String   @map("twitter_handle")
  evmAddress      String   @map("evm_address")
  completedQuests Json     @default("[]") @map("completed_quests")
  ipAddress       String?  @map("ip_address")
  createdAt       DateTime @default(now()) @map("created_at")

  @@index([twitterHandle])
  @@index([evmAddress])
  @@index([createdAt])
  @@map("registrations")
}

model QuestConfig {
  id    Int    @id @default(autoincrement())
  key   String @unique
  value String

  @@map("quest_config")
}
